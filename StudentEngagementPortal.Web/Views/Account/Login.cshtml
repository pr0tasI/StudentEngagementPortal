@model StudentEngagementPortal.Web.ViewModels.LoginViewModel

@{
ViewData["Title"] = "Login";
}

<style>
    body {
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
                     "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        color: #1d1d1f;
    }

    .login-page {
        max-width: 520px;
        margin: 55px auto;
        padding: 0 20px;
    }

    .login-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .login-header h1 {
        margin-bottom: 10px;
        font-size: 34px;
        font-weight: 600;
        letter-spacing: -0.6px;
    }

    .login-header p {
        margin: 0;
        color: #666;
        font-size: 16px;
    }

    .login-card {
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 14px;
        padding: 35px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
    }

    .form-group {
        margin-bottom: 22px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-size: 15px;
        font-weight: 500;
    }

    .form-control {
        width: 100%;
        box-sizing: border-box;
        padding: 12px 14px;
        border: 1px solid #ccc;
        border-radius: 10px;
        background: #fff;
        color: #1d1d1f;
        font-family: inherit;
        font-size: 15px;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: #0071e3;
        box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.12);
    }

    .validation {
        display: block;
        margin-top: 6px;
        color: #cc0000;
        font-size: 14px;
    }

    .validation-summary {
        margin-bottom: 20px;
        padding: 12px 15px;
        border-radius: 10px;
        background: #fdeaea;
        color: #b00000;
        font-size: 14px;
    }

    .remember-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 4px;
        font-size: 14px;
        color: #555;
    }

    .remember-row input {
        width: 16px;
        height: 16px;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }

    .button {
        flex: 1;
        display: inline-block;
        padding: 12px 20px;
        border: none;
        border-radius: 10px;
        text-align: center;
        text-decoration: none;
        font-family: inherit;
        font-size: 15px;
        font-weight: 500;
        cursor: pointer;
        box-sizing: border-box;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .button:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
    }

    .button-primary {
        background: #0071e3;
        color: white;
    }

    .button-primary:hover {
        background: #005bb5;
        color: white;
    }

    .button-secondary {
        background: #666;
        color: white;
    }

    .button-secondary:hover {
        background: #444;
        color: white;
    }

    .register-link {
        text-align: center;
        margin-top: 22px;
        font-size: 14px;
        color: #666;
    }

    .register-link a {
        color: #0071e3;
        text-decoration: none;
        font-weight: 500;
    }

    .register-link a:hover {
        text-decoration: underline;
    }

    @@media (max-width: 600px) {
        .login-page {
            margin: 30px auto;
        }

        .login-card {
            padding: 25px 20px;
        }

        .login-header h1 {
            font-size: 30px;
        }

        .form-actions {
            flex-direction: column;
        }
    }
</style>

<div class="login-page">

<div class="login-header">
    <h1>Welcome Back</h1>
    <p>Sign in to access the Student Engagement Portal.</p>
</div>

<div class="login-card">

    <form asp-controller="Account"
          asp-action="Login"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="ReturnUrl" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>
        }

        <div class="form-group">

            <label asp-for="Email"></label>

            <input asp-for="Email"
                   type="email"
                   class="form-control"
                   placeholder="Enter your email address"
                   autocomplete="email" />

            <span asp-validation-for="Email"
                  class="validation">
            </span>

        </div>

        <div class="form-group">

            <label asp-for="Password"></label>

            <input asp-for="Password"
                   type="password"
                   class="form-control"
                   placeholder="Enter your password"
                   autocomplete="current-password" />

            <span asp-validation-for="Password"
                  class="validation">
            </span>

        </div>

        <div class="remember-row">

            <input asp-for="RememberMe" />

            <label asp-for="RememberMe">
                Remember me
            </label>

        </div>

        <div class="form-actions">

            <button type="submit"
                    class="button button-primary">
                Login
            </button>

            <a href="/"
               class="button button-secondary">
                Back
            </a>

        </div>

    </form>

    <div class="register-link">
        Don't have an account?
        <a href="/Account/Register">Create Student Account</a>
    </div>

</div>

</div>
