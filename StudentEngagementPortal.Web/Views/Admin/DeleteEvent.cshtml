@model StudentEngagementPortal.Web.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<style>
    body {
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
                     "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        color: #1d1d1f;
    }

    .admin-page {
        max-width: 700px;
        margin: 60px auto;
        padding: 0 20px;
    }

    .delete-card {
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 14px;
        padding: 35px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
    }

    h1 {
        margin-top: 0;
        font-size: 32px;
        font-weight: 600;
        letter-spacing: -0.6px;
    }

    .warning {
        background: #fff3f3;
        border: 1px solid #f0caca;
        border-radius: 10px;
        padding: 16px;
        margin: 25px 0;
        color: #9b0000;
    }

    .event-info {
        margin: 20px 0;
        line-height: 1.7;
    }

    .actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }

    .button {
        display: inline-block;
        padding: 11px 20px;
        border: none;
        border-radius: 10px;
        text-decoration: none;
        font-size: 15px;
        font-weight: 500;
        cursor: pointer;
        font-family: inherit;
    }

    .delete-button {
        background: #d70015;
        color: white;
    }

    .delete-button:hover {
        background: #b00012;
    }

    .cancel-button {
        background: #666;
        color: white;
    }

    .cancel-button:hover {
        background: #444;
    }

    @@media (max-width: 600px) {
        .admin-page {
            margin: 30px auto;
        }

        .delete-card {
            padding: 22px;
        }

        .actions {
            flex-direction: column;
        }

        .button {
            text-align: center;
        }
    }
</style>

<div class="admin-page">

    <div class="delete-card">

        <h1>Delete Event</h1>

        <div class="warning">
            <strong>Warning:</strong>
            This action permanently deletes the event and its registrations.
            This cannot be undone.
        </div>

        <div class="event-info">

            <p>
                <strong>Event:</strong> @Model.Title
            </p>

            <p>
                <strong>Date:</strong>
                @Model.EventDateTime.ToLocalTime().ToString("dd MMMM yyyy HH:mm")
            </p>

            <p>
                <strong>Location:</strong> @Model.Location
            </p>

            <p>
                <strong>Registrations:</strong>
                @Model.RegisteredCount / @Model.Capacity
            </p>

        </div>

        <form asp-action="DeleteEventConfirmed"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <div class="actions">

                <button type="submit"
                        class="button delete-button">
                    Delete Event
                </button>

                <a href="/Admin"
                   class="button cancel-button">
                    Keep Event
                </a>

            </div>

        </form>

    </div>

</div>