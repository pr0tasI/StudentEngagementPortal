@model StudentEngagementPortal.Web.Models.Announcement

@{
    ViewData["Title"] = "Create Announcement";
}

<style>
    body {
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
                     "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        color: #1d1d1f;
    }

    .admin-page {
        max-width: 850px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .admin-header {
        margin-bottom: 30px;
    }

    .admin-header h1 {
        margin-bottom: 8px;
        font-size: 34px;
        font-weight: 600;
        letter-spacing: -0.6px;
    }

    .admin-header p {
        color: #666;
        font-size: 16px;
    }

    .announcement-card {
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 14px;
        padding: 35px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
    }

    .form-group {
        margin-bottom: 22px;
    }

    .form-group label {
        display: block;
        font-weight: 500;
        margin-bottom: 8px;
    }

    .form-control {
        width: 100%;
        box-sizing: border-box;
        padding: 12px 14px;
        border: 1px solid #ccc;
        border-radius: 10px;
        font-size: 15px;
        font-family: inherit;
    }

    .form-control:focus {
        outline: none;
        border-color: #0071e3;
        box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.12);
    }

    textarea.form-control {
        resize: vertical;
        min-height: 180px;
    }

    .validation {
        display: block;
        color: #cc0000;
        margin-top: 6px;
        font-size: 14px;
    }

    .validation-summary {
        color: #cc0000;
        margin-bottom: 20px;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }

    .button {
        display: inline-block;
        padding: 11px 20px;
        border: none;
        border-radius: 10px;
        text-decoration: none;
        font-size: 15px;
        font-weight: 500;
        cursor: pointer;
        font-family: inherit;
    }

    .button-primary {
        background: #0071e3;
        color: white;
    }

    .button-primary:hover {
        background: #005bb5;
    }

    .button-secondary {
        background: #666;
        color: white;
    }

    .button-secondary:hover {
        background: #444;
    }

    @@media (max-width: 650px) {
        .announcement-card {
            padding: 22px;
        }

        .form-actions {
            flex-direction: column;
        }

        .button {
            text-align: center;
        }
    }
</style>

<div class="admin-page">

    <div class="admin-header">
        <h1>Create Announcement</h1>
        <p>Share important information with students.</p>
    </div>

    <div class="announcement-card">

        <form asp-action="CreateAnnouncement" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="validation-summary">
            </div>

            <div class="form-group">

                <label asp-for="Title"></label>

                <input asp-for="Title"
                       class="form-control"
                       placeholder="Enter announcement title" />

                <span asp-validation-for="Title"
                      class="validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="Body">Announcement</label>

                <textarea asp-for="Body"
                          class="form-control"
                          placeholder="Write your announcement..."></textarea>

                <span asp-validation-for="Body"
                      class="validation">
                </span>

            </div>

            <div class="form-actions">

                <button type="submit"
                        class="button button-primary">
                    Post Announcement
                </button>

                <a href="/Admin/Announcements"
                   class="button button-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>