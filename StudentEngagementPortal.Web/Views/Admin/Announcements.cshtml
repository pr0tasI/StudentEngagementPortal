
@model IEnumerable<StudentEngagementPortal.Web.Models.Announcement>

@{
    ViewData["Title"] = "Announcements";
}

<style>
    body {
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
                     "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        color: #1d1d1f;
    }

    .admin-page {
        max-width: 900px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .admin-header {
        margin-bottom: 30px;
    }

    .admin-header h1 {
        margin-bottom: 8px;
        font-size: 34px;
        font-weight: 600;
        letter-spacing: -0.6px;
    }

    .admin-header p {
        color: #666;
        font-size: 16px;
    }

    .announcement-card {
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 14px;
        padding: 25px;
        margin: 18px 0;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
    }

    .announcement-card h2 {
        margin-top: 0;
        margin-bottom: 10px;
        font-size: 22px;
        font-weight: 600;
    }

    .announcement-date {
        color: #777;
        font-size: 14px;
        margin-bottom: 18px;
    }

    .announcement-body {
        color: #444;
        line-height: 1.6;
        white-space: pre-line;
    }

    .button {
        display: inline-block;
        padding: 11px 20px;
        border-radius: 10px;
        text-decoration: none;
        font-size: 15px;
        font-weight: 500;
        margin-top: 15px;
    }

    .button-primary {
        background: #0071e3;
        color: white;
    }

    .button-secondary {
        background: #666;
        color: white;
        margin-left: 8px;
    }

    .empty-message {
        padding: 25px;
        background: #f7f7f7;
        border-radius: 10px;
        color: #666;
    }

    .success-message {
        padding: 12px 16px;
        margin-bottom: 20px;
        background: #e8f5e9;
        color: #217a2b;
        border-radius: 10px;
    }

    @@media (max-width: 600px) {
        .admin-page {
            margin: 25px auto;
        }

        .announcement-card {
            padding: 20px;
        }

        .button {
            display: block;
            text-align: center;
            margin-left: 0;
        }
    }
</style>

<div class="admin-page">

    <div class="admin-header">
        <h1>Announcements</h1>
        <p>Manage information shared with students.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="success-message">
            @TempData["Success"]
        </div>
    }

    <a href="/Admin/CreateAnnouncement"
       class="button button-primary">
        Create Announcement
    </a>

    <a href="/Admin/Index"
       class="button button-secondary">
        Back to Dashboard
    </a>

    @if (!Model.Any())
    {
        <div class="empty-message">
            No announcements have been posted yet.
        </div>
    }
    else
    {
        @foreach (var announcement in Model)
        {
            <div class="announcement-card">

                <h2>@announcement.Title</h2>

                <div class="announcement-date">
                    Posted
                    @announcement.PostedAtUtc.ToLocalTime()
                        .ToString("dd MMMM yyyy HH:mm")
                    by
                    @(announcement.PostedBy?.FullName ?? "Admin")
                </div>

                <div class="announcement-body">
                    @announcement.Body
                </div>

            </div>
        }
    }

</div>

