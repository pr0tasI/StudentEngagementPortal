@model StudentEngagementPortal.Web.Models.Message

@{
    ViewData["Title"] = "Student Support";
}

<style>
    .support-page {
        max-width: 850px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .support-header {
        margin-bottom: 30px;
    }

    .support-header h1 {
        margin-bottom: 8px;
        font-size: 34px;
        font-weight: 600;
        letter-spacing: -0.6px;
        color: #1d1d1f;
    }

    .support-header p {
        color: #666;
        font-size: 16px;
    }

    .support-card {
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 14px;
        padding: 35px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
    }

    .form-group {
        margin-bottom: 22px;
    }

    .form-group label {
        display: block;
        font-weight: 500;
        margin-bottom: 8px;
        color: #1d1d1f;
    }

    .form-control {
        width: 100%;
        box-sizing: border-box;
        padding: 12px 14px;
        border: 1px solid #ccc;
        border-radius: 10px;
        font-size: 15px;
        font-family: inherit;
    }

    .form-control:focus {
        outline: none;
        border-color: #0071e3;
        box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.12);
    }

    textarea.form-control {
        resize: vertical;
        min-height: 150px;
    }

    .validation {
        display: block;
        color: #cc0000;
        margin-top: 6px;
        font-size: 14px;
    }

    .validation-summary {
        color: #cc0000;
        margin-bottom: 20px;
    }

    .success-message {
        background: #e8f5e9;
        color: #217a2b;
        border-radius: 10px;
        padding: 14px 16px;
        margin-bottom: 22px;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }

    .button {
        display: inline-block;
        padding: 11px 20px;
        border: none;
        border-radius: 10px;
        text-decoration: none;
        font-size: 15px;
        font-weight: 500;
        cursor: pointer;
        font-family: inherit;
    }

    .button-primary {
        background: #0071e3;
        color: white;
    }

    .button-primary:hover {
        background: #005bb5;
    }

    .button-secondary {
        background: #666;
        color: white;
    }

    .button-secondary:hover {
        background: #444;
    }

    @@media (max-width: 650px) {
        .support-page {
            margin: 25px auto;
        }

        .support-card {
            padding: 22px;
        }

        .form-actions {
            flex-direction: column;
        }

        .button {
            text-align: center;
        }
    }
</style>

<div class="support-page">

    <div class="support-header">
        <h1>Student Support</h1>
        <p>Need help? Send a message to the student support team.</p>
    </div>

    <div class="support-card">

        @if (TempData["Success"] != null)
        {
            <div class="success-message">
                @TempData["Success"]
            </div>
        }

        <form asp-action="Index" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Subject"></label>

                <input asp-for="Subject"
                       class="form-control"
                       placeholder="What do you need help with?" />

                <span asp-validation-for="Subject" class="validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Body">Message</label>

                <textarea asp-for="Body"
                          class="form-control"
                          placeholder="Describe your question or problem..."></textarea>

                <span asp-validation-for="Body" class="validation"></span>
            </div>

            <div class="form-actions">

                <button type="submit" class="button button-primary">
                    Send Message
                </button>

                <a href="/Events" class="button button-secondary">
                    Back to Events
                </a>

            </div>

        </form>

    </div>

</div>