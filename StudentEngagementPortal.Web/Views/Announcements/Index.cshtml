@model IEnumerable<StudentEngagementPortal.Web.Models.Announcement>

@{
    ViewData["Title"] = "Announcements";
}

<style>
    body {
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
                     "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        color: #1d1d1f;
    }

    .announcements-page {
        max-width: 900px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .page-header {
        margin-bottom: 30px;
    }

    .page-header h1 {
        margin-bottom: 8px;
        font-size: 34px;
        font-weight: 600;
        letter-spacing: -0.6px;
    }

    .page-header p {
        color: #666;
        font-size: 16px;
    }

    .announcement-card {
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 14px;
        padding: 25px;
        margin: 18px 0;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
    }

    .announcement-card h2 {
        margin-top: 0;
        margin-bottom: 10px;
        font-size: 22px;
        font-weight: 600;
        letter-spacing: -0.3px;
    }

    .announcement-date {
        color: #777;
        font-size: 14px;
        margin-bottom: 18px;
    }

    .announcement-body {
        color: #444;
        line-height: 1.6;
        white-space: pre-line;
    }

    .back-button {
        display: inline-block;
        margin-top: 20px;
        padding: 11px 20px;
        border-radius: 10px;
        background: #666;
        color: white;
        text-decoration: none;
        font-size: 15px;
        font-weight: 500;
    }

    .back-button:hover {
        background: #444;
    }

    .empty-message {
        padding: 25px;
        background: #f7f7f7;
        border-radius: 10px;
        color: #666;
    }

    @@media (max-width: 600px) {
        .announcements-page {
            margin: 25px auto;
        }

        .announcement-card {
            padding: 20px;
        }
    }
</style>

<div class="announcements-page">

    <div class="page-header">
        <h1>Announcements</h1>
        <p>Stay up to date with the latest student information.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-message">
            There are currently no announcements.
        </div>
    }
    else
    {
        @foreach (var announcement in Model)
        {
            <div class="announcement-card">

                <h2>@announcement.Title</h2>

                <div class="announcement-date">
                    Posted
                    @announcement.PostedAtUtc.ToLocalTime().ToString("dd MMMM yyyy HH:mm")
                    by
                    @(announcement.PostedBy?.FullName ?? "Admin")
                </div>

                <div class="announcement-body">
                    @announcement.Body
                </div>

            </div>
        }
    }

    <a href="/Events" class="back-button">
        Back to Events
    </a>

</div>