
@{
    ViewData["Title"] = "Student Engagement Portal";
}

<style>
    body {
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
                     "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        color: #1d1d1f;
    }

    .home-container {
        max-width: 900px;
        margin: 80px auto;
        padding: 0 20px;
        text-align: center;
    }

    .home-container h1 {
        font-size: 42px;
        font-weight: 600;
        letter-spacing: -1px;
        margin-bottom: 18px;
    }

    .home-container p {
        font-size: 20px;
        color: #666;
        margin-bottom: 35px;
    }

    .home-buttons {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .home-button {
        display: inline-block;
        padding: 12px 24px;
        border-radius: 10px;
        background: #0071e3;
        color: white;
        text-decoration: none;
        font-size: 15px;
        font-weight: 500;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .home-button:hover {
        background: #005bb5;
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
    }

    .home-button.secondary {
        background: #666;
    }

    .home-button.secondary:hover {
        background: #444;
    }

    .home-button.events {
        background: #34a853;
    }

    .home-button.events:hover {
        background: #27863f;
    }

    @@media (max-width: 600px) {
        .home-container {
            margin: 50px auto;
        }

        .home-container h1 {
            font-size: 34px;
        }

        .home-container p {
            font-size: 18px;
        }

        .home-buttons {
            flex-direction: column;
        }

        .home-button {
            width: 100%;
            box-sizing: border-box;
        }
    }
</style>

<div class="home-container">

    <h1>Student Engagement Portal</h1>

    <p>Welcome to the Student Engagement Portal.</p>

    <div class="home-buttons">

        <a href="/Account/Login"
           class="home-button">
            Login
        </a>

        <a href="/Account/Register"
           class="home-button secondary">
            Register
        </a>

        <a href="/Events"
           class="home-button events">
            View Events
        </a>

    </div>

</div>
